# ---------------------------------------------------------------------------
# Public site
# ---------------------------------------------------------------------------
# Absolute URL of the deployment; used for canonical/OG URLs and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://nedalelabid.com

# ---------------------------------------------------------------------------
# Admin authentication (required in production)
# ---------------------------------------------------------------------------
# Generate the hash and secret with:  npm run admin:hash -- "your-password"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Dev-only alternative to ADMIN_PASSWORD_HASH (plain text, never use in prod).
# ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Data layer
# ---------------------------------------------------------------------------
# With these set, the CMS uses Supabase (Postgres + Storage). Without them it
# falls back to the file-backed adapter at data/cms.json — fine for local work,
# not for serverless/read-only hosting.
# The service-role key is read on the server only; never expose it to the client.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=media

# Optional: move the JSON data file (file adapter only).
# CMS_DATA_FILE=./data/cms.json

# Optional: where dashboard uploads are written when Supabase is not
# configured. They are served through the /uploads route, not from public/,
# because Next only serves public/ files that existed at build time.
# UPLOAD_DIR=./data/uploads
